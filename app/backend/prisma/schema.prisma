generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  fullname String
  username String @unique
  email    String
  password String

  @@map("admin")
}

model Restaurant {
  id            Int      @id @default(autoincrement())
  restroname    String
  mobileno      String
  email         String
  address       String
  password      String
  gstno         String?
  logo          String?
  themecode     Int?
  status        Int      @default(1)
  latitude      String?
  longitude     String?
  distance      String?
  joindate      DateTime @default(now())
  paymentdate   DateTime @default(now())
  subtype       Int      @default(0)
  subplan       Int      @default(1)
  expdate       DateTime @default(now())
  price         Int      @default(0)
  pdf           String?
  slug          String   @unique
  restrootp     String   @default("0")
  discount      Float    @default(0)
  servicecharge Float    @default(0)
  maxStaff      Int      @default(5)

  // Mega+Web website fields
  websiteEnabled  Boolean  @default(false)
  tagline         String?
  aboutText       String?
  bannerImage     String?
  aboutImage      String?
  openingHours    String?  @default("{}")
  phone           String?
  whatsapp        String?
  facebookUrl     String?
  instagramUrl    String?
  galleryImages   String?  @default("[]")
  mapEmbed        String?

  theme          Theme?           @relation(fields: [themecode], references: [id])
  categories     Category[]
  menuItems      MenuItem[]
  tables         Table[]
  orders         Order[]
  orderHistory   OrderHistory[]
  feedback       Feedback[]
  paymentHistory PaymentHistory[]
  waiterRequests WaiterRequest[]
  staff          Staff[]

  @@map("restro")
}

model Staff {
  id         Int      @id @default(autoincrement())
  restroid   Int
  fullname   String
  username   String   @unique
  password   String
  role       String   @default("staff")  // manager | cashier | staff
  status     Int      @default(1)
  createdAt  DateTime @default(now())

  restaurant Restaurant @relation(fields: [restroid], references: [id], onDelete: Cascade)

  @@map("staff")
}

model Theme {
  id              Int          @id @default(autoincrement())
  title           String
  image           String?
  primaryColor    String       @default("#f97316")
  secondaryColor  String       @default("#1f2937")
  accentColor     String       @default("#fbbf24")
  bgColor         String       @default("#f9fafb")
  cardColor       String       @default("#ffffff")
  textColor       String       @default("#111827")
  navBg           String       @default("#ffffff")
  buttonTextColor String       @default("#ffffff")
  fontFamily      String       @default("Inter")
  borderRadius    String       @default("rounded")
  darkMode        Boolean      @default(false)
  restaurants     Restaurant[]

  @@map("theme")
}

model Category {
  id           Int        @id @default(autoincrement())
  restroid     Int
  name_eng     String
  name_guj     String?
  name_hindi   String?
  categorydesc String?
  sortorder    Int        @default(0)

  restaurant Restaurant @relation(fields: [restroid], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@map("category")
}

model MenuItem {
  id         Int     @id @default(autoincrement())
  restroid   Int
  categoryid Int
  image      String?
  name_eng   String
  name_guj   String?
  name_hindi String?
  veg        Boolean @default(true)
  available  Boolean @default(true)
  price      Float

  restaurant Restaurant  @relation(fields: [restroid], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryid], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("menuitems")
}

model Table {
  id       Int     @id @default(autoincrement())
  restroid Int
  name     String
  qrimage  String?

  restaurant     Restaurant      @relation(fields: [restroid], references: [id], onDelete: Cascade)
  orders         Order[]
  waiterRequests WaiterRequest[]

  @@map("tables")
}

model Order {
  id            Int         @id @default(autoincrement())
  restroid      Int
  tableid       Int?
  ordercode     String      @unique
  customername  String?
  customermob   String?
  status        OrderStatus @default(PENDING)
  subtotal      Float       @default(0)
  discount      Float       @default(0)
  servicecharge Float       @default(0)
  grandtotal    Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant Restaurant  @relation(fields: [restroid], references: [id], onDelete: Cascade)
  table      Table?      @relation(fields: [tableid], references: [id])
  items      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderid    Int
  menuitemid Int
  name_eng   String
  name_guj   String?
  name_hindi String?
  price      Float
  quantity   Int
  totalprice Float

  order    Order    @relation(fields: [orderid], references: [id], onDelete: Cascade)
  menuitem MenuItem @relation(fields: [menuitemid], references: [id])

  @@map("orderitems")
}

model OrderHistory {
  id            Int      @id @default(autoincrement())
  restroid      Int
  ordercode     String
  tablename     String?
  customername  String?
  customermob   String?
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  servicecharge Float    @default(0)
  grandtotal    Float    @default(0)
  timestamp     DateTime @default(now())

  restaurant Restaurant    @relation(fields: [restroid], references: [id], onDelete: Cascade)
  items      HistoryItem[]

  @@map("orderhistory")
}

model HistoryItem {
  id         Int     @id @default(autoincrement())
  orderid    Int
  name_eng   String
  name_guj   String?
  name_hindi String?
  price      Float
  quantity   Int
  totalprice Float

  order OrderHistory @relation(fields: [orderid], references: [id], onDelete: Cascade)

  @@map("historyitem")
}

model Feedback {
  id        Int       @id @default(autoincrement())
  restroid  Int
  fullname  String
  mobile    String?
  email     String?
  feedback  String?
  dob       DateTime?
  timestamp DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restroid], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model PaymentHistory {
  id          Int      @id @default(autoincrement())
  restroid    Int
  paymentdate DateTime
  subplan     Int
  price       Int
  subtype     Int
  expdate     DateTime

  restaurant Restaurant @relation(fields: [restroid], references: [id], onDelete: Cascade)

  @@map("paymenthistory")
}

model WaiterRequest {
  id        Int      @id @default(autoincrement())
  restroid  Int
  tableid   Int?
  status    Int      @default(0)
  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restroid], references: [id], onDelete: Cascade)
  table      Table?     @relation(fields: [tableid], references: [id])

  @@map("waiterrequests")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
