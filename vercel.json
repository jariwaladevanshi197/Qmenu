{
  "version": 2,
  "buildCommand": "cd app/backend && npm install && npx prisma generate && cd ../frontend && npm install && npm run build",
  "outputDirectory": "app/frontend/dist",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "app/backend/src/assets/fonts/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
